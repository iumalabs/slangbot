#!/bin/sh
# Pre-commit gate: the same checks CI runs, so broken commits never leave the
# machine. Install once with `deno task hooks:install`.
# Bypass in an emergency with `git commit --no-verify`.

set -e

echo "pre-commit: secret scan"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found. Install it (e.g. 'go install github.com/zricethezav/gitleaks/v8@latest'" >&2
  echo "or 'brew install gitleaks') — secret scanning runs locally only, there is no CI backstop." >&2
  exit 1
fi
gitleaks protect --staged --no-banner -v

echo "pre-commit: format check"
deno fmt --check

echo "pre-commit: lint"
deno lint

echo "pre-commit: typecheck"
deno task check

echo "pre-commit: AI isolation"
deno task check:ai

echo "pre-commit: tests"
deno task test:coverage

echo "pre-commit: route/e2e coverage gate"
deno task check:coverage

echo "pre-commit: all checks passed"
