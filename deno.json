{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno install && deno run -A scripts/dev.ts",
    "build": "deno install && deno run -A scripts/build-client.ts",
    "build:client": "deno run -A scripts/build-client.ts",
    "test": "deno test -A",
    "lint": "deno lint && deno fmt --check",
    "check": "deno check src/index.tsx src/client/entry-client.tsx",
    "check:ai": "deno run -A scripts/check-ai-isolation.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "deploy:preview": "deno run -A npm:wrangler@latest versions upload",
    "deploy:production": "deno run -A npm:wrangler@latest d1 migrations apply slangbot-db --remote && deno run -A npm:wrangler@latest deploy",
    "db:migrate:local": "deno run -A npm:wrangler@latest d1 migrations apply slangbot-db --local",
    "db:migrate:remote": "deno run -A npm:wrangler@latest d1 migrations apply slangbot-db --remote",
    "seed": "deno run -A npm:wrangler@latest d1 execute slangbot-db --local --file=scripts/seed-demo.sql"
  },
  "imports": {
    "react": "npm:react@18.3.1",
    "react/jsx-runtime": "npm:react@18.3.1/jsx-runtime",
    "react-dom": "npm:react-dom@18.3.1",
    "react-dom/server": "npm:react-dom@18.3.1/server",
    "react-dom/client": "npm:react-dom@18.3.1/client",
    "hono": "npm:hono@4.7.11",
    "hono/": "npm:/hono@4.7.11/",
    "workers-og": "npm:workers-og@0.0.25",
    "@types/react": "npm:@types/react@18.3.12",
    "esbuild": "npm:esbuild@0.25.5",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.11.1",
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@types/react", "./src/cf-types.d.ts"],
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "fmt": {
    "exclude": ["assets/client.js", "migrations/"]
  },
  "lint": {
    "exclude": ["assets/client.js"],
    "rules": {
      "tags": ["recommended"],
      "include": ["no-sloppy-imports", "no-slow-types"]
    }
  }
}
